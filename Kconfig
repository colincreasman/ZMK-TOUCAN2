config ZMK_BEHAVIOR_LONG_PRESS
    bool "Long-press behavior"
    default y
    help
      Invoke a behavior only after its key remains held for a configured duration.

DT_COMPAT_ZMK_INPUT_PROCESSOR_ACCEL := zmk,input-processor-accel

config ZMK_INPUT_PROCESSOR_ACCEL
    bool "Pointer acceleration input processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_ACCEL))
    depends on ZMK_POINTING
    help
      Velocity-based pointer acceleration with a movement activation gate. Only
      built for boards that actually instantiate the node, which keeps
      pointer-less targets such as settings_reset unaffected.

DT_COMPAT_ZMK_INPUT_PROCESSOR_SWIPE_ARBITER := zmk,input-processor-swipe-arbiter

config ZMK_INPUT_PROCESSOR_SWIPE_ARBITER
    bool "Three-finger swipe arbiter input processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_SWIPE_ARBITER))
    depends on ZMK_POINTING
    help
      Collapses a stream of raw swipe direction samples into a single actuation
      in the dominant direction.

DT_COMPAT_ZMK_INPUT_PROCESSOR_SCROLL_SHORTCUT := zmk,input-processor-scroll-shortcut

config ZMK_INPUT_PROCESSOR_SCROLL_SHORTCUT
    bool "Scroll-to-shortcut input processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_SCROLL_SHORTCUT))
    depends on ZMK_POINTING
    help
      Turns accumulated travel on a relative scroll axis into a single key-combo
      actuation per gesture.

DT_COMPAT_ZMK_INPUT_PROCESSOR_ROTATE := zmk,input-processor-rotate

config ZMK_INPUT_PROCESSOR_ROTATE
    bool "Pointer rotation input processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_ROTATE))
    depends on ZMK_POINTING
    help
      Rotates relative pointer movement by a fixed angle to compensate for a
      trackpad that is physically mounted at an angle to the keyboard.

DT_COMPAT_ZMK_INPUT_PROCESSOR_TAP_DRAG := zmk,input-processor-tap-drag

config ZMK_INPUT_PROCESSOR_TAP_DRAG
    bool "Double-tap-and-hold drag input processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_TAP_DRAG))
    depends on ZMK_POINTING
    help
      Turns a tap followed straight away by a held touch into a left-button
      drag, like macOS's tap to drag.

DT_COMPAT_ZMK_BEHAVIOR_OS_SELECT := zmk,behavior-os-select
DT_COMPAT_ZMK_BEHAVIOR_OS_MODE := zmk,behavior-os-mode

config ZMK_BEHAVIOR_OS_SELECT
    bool "OS-select behavior"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_OS_SELECT))
    select TOUCAN_OS_MODE
    help
      Invoke one of two bindings depending on the current host-OS mode.

config ZMK_BEHAVIOR_OS_MODE
    bool "OS-mode behavior"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_OS_MODE))
    select TOUCAN_OS_MODE
    help
      Select or toggle the host-OS mode used by the OS-select behavior.

config TOUCAN_OS_MODE
    bool
    help
      Shared, persisted host-OS mode state. Selected automatically by the
      behaviors that need it.

config TOUCAN_OS_MODE_DEFAULT_WIN
    bool "Default to Windows OS mode"
    depends on TOUCAN_OS_MODE
    help
      Power on in Windows mode rather than macOS mode. Only applies until a
      mode has been stored; after that the saved value wins.
