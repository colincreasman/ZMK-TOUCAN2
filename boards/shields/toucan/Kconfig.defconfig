if SHIELD_TOUCAN_LEFT

config ZMK_KEYBOARD_NAME
    default "Toucan"

# The left half is the central in standalone mode. Listing the
# toucan_left_peripheral modifier shield alongside it turns it into a plain
# peripheral for dongle mode instead. ZMK's own definition of this symbol has
# no default, so withholding this one is all that takes.
config ZMK_SPLIT_ROLE_CENTRAL
    default y if !SHIELD_TOUCAN_LEFT_PERIPHERAL

endif



if SHIELD_TOUCAN_DONGLE

config ZMK_KEYBOARD_NAME
    default "Toucan Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Both keyboard halves are peripherals of the dongle.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

endif



# Whichever part is central (the left half standalone, the dongle otherwise)
# fetches and re-exposes the other parts' battery levels.
#
# The role guard is load-bearing. Each `config` entry below is an additional
# definition of the symbol whose only dependencies are the enclosing `if`
# conditions, so without it these defaults would switch the options on for the
# left half in dongle mode too, even though ZMK defines them for the central
# role only -- and central_bas_proxy.c then fails to compile on a peripheral.
if (SHIELD_TOUCAN_LEFT || SHIELD_TOUCAN_DONGLE) && ZMK_SPLIT_ROLE_CENTRAL

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

endif



if SHIELD_TOUCAN_LEFT || SHIELD_TOUCAN_RIGHT || SHIELD_TOUCAN_DONGLE

config ZMK_SPLIT
    default y

config ZMK_POINTING
    default y

endif



if SHIELD_TOUCAN_LEFT || SHIELD_TOUCAN_RIGHT

config SPI
    default y

config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
    default 40

endif



# Standalone left half with englmaxi's dongle_display status screen on its
# nice!view instead of the gem screen: the same bongo cat, modifiers and battery
# readout the USB dongle's OLED shows. Dark theme, so it matches the gem screen
# and the OLED. The WPM meter is switched on in build.yaml: dongle_display
# defines it with `default n`, and the first default parsed wins.
if SHIELD_TOUCAN_LEFT && SHIELD_DONGLE_DISPLAY && ZMK_SPLIT_ROLE_CENTRAL

config ZMK_DISPLAY_INVERT
    default y

config ZMK_DONGLE_DISPLAY_DONGLE_BATTERY
    default y

config ZMK_DONGLE_DISPLAY_MAC_MODIFIERS
    default y

endif
