#include <input/processors.dtsi>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

//#define TOUCAN_WIN_MODE

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
        //zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

    row-gpios
    = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
    ;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   37       0     0     0>
            , <&key_physical_attrs 100 100  100   37       0     0     0>
            , <&key_physical_attrs 100 100  200   12       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   12       0     0     0>
            , <&key_physical_attrs 100 100  500   24       0     0     0>
            , <&key_physical_attrs 100 100  800   24       0     0     0>
            , <&key_physical_attrs 100 100  900   12       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100   12       0     0     0>
            , <&key_physical_attrs 100 100 1200   37       0     0     0>
            , <&key_physical_attrs 100 100 1300   37       0     0     0>
            , <&key_physical_attrs 100 100    0  137       0     0     0>
            , <&key_physical_attrs 100 100  100  137       0     0     0>
            , <&key_physical_attrs 100 100  200  112       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  112       0     0     0>
            , <&key_physical_attrs 100 100  500  124       0     0     0>
            , <&key_physical_attrs 100 100  800  124       0     0     0>
            , <&key_physical_attrs 100 100  900  112       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  112       0     0     0>
            , <&key_physical_attrs 100 100 1200  137       0     0     0>
            , <&key_physical_attrs 100 100 1300  137       0     0     0>
            , <&key_physical_attrs 100 100    0  237       0     0     0>
            , <&key_physical_attrs 100 100  100  237       0     0     0>
            , <&key_physical_attrs 100 100  200  212       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  212       0     0     0>
            , <&key_physical_attrs 100 100  500  224       0     0     0>
            , <&key_physical_attrs 100 100  800  224       0     0     0>
            , <&key_physical_attrs 100 100  900  212       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  212       0     0     0>
            , <&key_physical_attrs 100 100 1200  237       0     0     0>
            , <&key_physical_attrs 100 100 1300  237       0     0     0>
            , <&key_physical_attrs 100 100  350  312       0     0     0>
            , <&key_physical_attrs 100 100  450  312    1200   450   412>
            , <&key_physical_attrs 100 100  548  328    2400   548   433>
            , <&key_physical_attrs 100 100  752  328  (-2400)  852   433>
            , <&key_physical_attrs 100 100  850  312  (-1200)  950   412>
            , <&key_physical_attrs 100 100  950  312       0     0     0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        // | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
        // | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
        // | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
        //                      | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
                map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};

/ {
    input_processors {
        zip_zoom_mapper: zip_zoom_mapper {
            compatible = "zmk,input-processor-zoom";
            #input-processor-cells = <0>;
            event-code = <INPUT_REL_MISC>;
            sensitivity = <10>;
#ifdef TOUCAN_WIN_MODE
            bindings = <&kp LC(MINUS)>, <&kp LC(EQUAL)>;
#else
            bindings = <&kp LG(MINUS)>, <&kp LG(EQUAL)>;
#endif
            track-remainders;
        };

        // Compensates for the trackpad being mounted at an angle. This is
        // beekeeb's "Thumb Angle" variant, where the pad is rotated
        // COUNTER-CLOCKWISE by about 35 degrees (its top edge rises to the
        // right) so it faces the thumb. The alternative "Column Angle" variant
        // mounts the same pad square to the case. Fingers arrive square to the
        // keyboard either way, so on this variant a stroke that feels "straight
        // up" lands on the sensor as a diagonal.
        //
        // Rotating the reported vector counter-clockwise by the same 35 degrees
        // cancels the mount angle out, making the pad behave like the Column
        // Angle version.
        //
        // Sign convention: positive is counter-clockwise on screen, and the
        // correction matches the pad's own counter-clockwise mount, so this is
        // POSITIVE. Flip the sign if the cursor tracks the wrong diagonal;
        // change the magnitude if the correction is too strong or too weak.
        //
        // This runs first so everything downstream (the activation gate and the
        // acceleration curve) works in the hand's frame rather than the
        // sensor's. Only pointer movement is affected: scroll and the two/three
        // finger swipes are resolved inside the Azoteq driver, upstream of every
        // input processor, so the gesture tuning tagged as `gestures-dialed-in`
        // is untouched.
        pointer_rotate: pointer_rotate {
            compatible = "zmk,input-processor-rotate";
            #input-processor-cells = <0>;
            angle = <35>;
            x-code = <INPUT_REL_X>;
            y-code = <INPUT_REL_Y>;
            reset-ms = <300>;
        };

        // Pointer acceleration plus a movement activation gate. This runs FIRST
        // in trackpad_listener's chain for two reasons: it should shape the raw
        // deltas before anything else looks at them, and it needs to observe
        // INPUT_BTN_TOUCH, which is_touching_processor consumes with
        // ZMK_INPUT_PROC_STOP before later processors ever see it.
        //
        //   - activation-distance: the first 8 counts of travel after each new
        //     touch are swallowed, so resting or brushing a finger while typing
        //     cannot nudge the cursor. It re-arms on every finger lift.
        //   - min-factor 800 keeps slow movement at 0.8x, which lands at the
        //     same deliberate, "sluggish" feel as the old bare sensitivity = 80
        //     now that the driver runs at its 100 baseline again.
        //   - Past speed-threshold the factor climbs on a quadratic curve to
        //     2.2x at speed-max. The quadratic keeps almost the whole low range
        //     near min-factor, so only a genuinely long stroke speeds up. The
        //     thresholds are deliberately conservative: if the pad reports
        //     slower than expected the curve degrades to a flat 0.8x rather
        //     than overshooting.
        //
        // If the pointer ever needs to go back to plain, unshaped movement,
        // drop &pointer_accel from trackpad_listener's input-processors below;
        // the driver's `sensitivity` then applies on its own.
        // track-remainders is required: with min-factor below 1.0 the sub-count
        // fractions would otherwise be truncated away and slow drags would stall.
        pointer_accel: pointer_accel {
            compatible = "zmk,input-processor-accel";
            #input-processor-cells = <0>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y>;
            track-remainders;
            min-factor = <800>;
            max-factor = <2200>;
            speed-threshold = <500>;
            speed-max = <3000>;
            acceleration-exponent = <2>;
            activation-distance = <5>;
            activation-reset-ms = <300>;
        };

        // Collapses the driver's raw swipe samples into one correctly-directed
        // actuation per gesture. The driver picks a direction from the first
        // nonzero delta of a gesture and reports each axis independently, so
        // fingers settling at touchdown can fire the wrong axis; its throttle
        // then blocks the real direction for the rest of the window. That is
        // why a clean 3-finger up swipe lands instantly while a left/right one
        // is hard to trigger and hard to retry.
        //
        // three-finger-swipe-throttle-ms is turned down to 40 in
        // toucan_right.overlay so this node sees a stream of samples rather
        // than a single noisy one. It stays silent until one axis leads the
        // other by `lead` samples, emits exactly one press/release pair in the
        // winning direction, then blocks until the fingers lift. Net effect for
        // an unambiguous swipe is one actuation, same as before, about 40ms
        // later; retries no longer have to wait out a 1200ms lockout.
        //
        // To restore the old raw behavior: drop &swipe_arbiter from the
        // pipeline below and set the throttle back to 1200.
        swipe_arbiter: swipe_arbiter {
            compatible = "zmk,input-processor-swipe-arbiter";
            #input-processor-cells = <0>;
            lead = <2>;
            max-samples = <8>;
            reset-ms = <400>;
        };

        // Two-finger horizontal swipe -> browser/editor back and forward.
        //
        // The driver only reports swipe buttons for THREE-finger movement, so a
        // two-finger horizontal swipe arrives here as plain scroll on
        // INPUT_REL_HWHEEL. Sending that as a horizontal wheel does not produce
        // page navigation on macOS (that is a native trackpad gesture, not a
        // wheel event), so it is turned into real Cmd+[ / Cmd+] keystrokes,
        // which also work in VS Code and anywhere else those are bound.
        //
        // This sits before zip_scroll_scaler so it sees raw counts rather than
        // the 1/100-damped value, and fires at most once per gesture: the
        // remaining travel is swallowed so a long swipe navigates one page
        // instead of several. Swap the two bindings if the directions come out
        // reversed.
        hscroll_shortcut: hscroll_shortcut {
            compatible = "zmk,input-processor-scroll-shortcut";
            #input-processor-cells = <0>;
            event-code = <INPUT_REL_HWHEEL>;
            threshold = <120>;
            reset-ms = <300>;
#ifdef TOUCAN_WIN_MODE
            bindings = <&kp LA(LEFT)>, <&kp LA(RIGHT)>;
#else
            bindings = <&kp LG(LBKT)>, <&kp LG(RBKT)>;
#endif
        };

        is_touching_processor:is_touching_processor {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;

            codes = <INPUT_BTN_TOUCH>;      // watch for the 'touch' pseudo button
            bindings  = <&mo 4>;            // Activate Layer 4 while held &mo 4
        };

        // 3-finger swipe shortcuts. These come from the driver's
        // `three-finger-swipe` path (enabled in toucan_right.overlay);
        // `swipes` stays off there, so ordinary 1-finger cursor flicks can
        // never fire any of these.
        //
        //   - Up -> Option+Grave. This Mac's Mission Control shortcut is
        //     remapped to Opt+` in System Settings > Keyboard > Keyboard
        //     Shortcuts > Mission Control, NOT the Ctrl+Up default, so Ctrl+Up
        //     did nothing at all here.
        //   - Left/right -> AltTab (the third-party app), matching the
        //     "3-finger Horizontal Swipe" trigger configured on this Mac's
        //     built-in trackpad. AltTab's Shortcut 1 is Opt+Tab, so right
        //     sends Opt+Tab (next window) and left sends Opt+Shift+Tab
        //     (previous window). Firmware sends a discrete press/release, so
        //     one swipe = one window step rather than a held-open switcher.
        //
        //     This replaces the previous Cmd+[ / Cmd+] page navigation. Browser
        //     back/forward is still reachable from macOS's native "Swipe between
        //     pages" gesture, which reads the two-finger horizontal scroll the
        //     driver already emits as INPUT_REL_HWHEEL, as long as that setting
        //     includes the two-finger variant.
        //   - Down is left unbound: every other Mission Control shortcut
        //     ("Application windows" = Ctrl+Down, "Show Desktop" = F11) is
        //     unchecked on this Mac, so there is nothing useful to send.
        //
        // The driver reports each nonzero axis independently, so a strongly
        // diagonal swipe can emit a vertical *and* a horizontal shortcut in the
        // same actuation. Swipe reasonably straight; the 1200ms throttle in
        // toucan_right.overlay keeps one motion from repeating.
        swipe_button_mapper: swipe_button_mapper {
            compatible = "zmk,input-processor-behaviors";
            #input-processor-cells = <0>;
            codes = <INPUT_BTN_NORTH INPUT_BTN_EAST INPUT_BTN_SOUTH INPUT_BTN_WEST>;
#ifdef TOUCAN_WIN_MODE
            bindings = <&kp LG(TAB)>, <&kp LG(RIGHT)>, <&kp LG(D)>, <&kp LG(LEFT)>;
#else
            bindings = <&kp LA(GRAVE)>, <&kp LA(TAB)>, <&none>, <&kp LA(LS(TAB))>;
#endif
        };
    };


    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad_split: trackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackpad_split>;
        // Scroll scaling: the tps43 driver reports raw trackpad counts as
        // INPUT_REL_WHEEL, and every wheel unit is a full scroll notch on the
        // host (~3 lines on macOS, then multiplied again by macOS's scroll
        // acceleration). At 1/20 a normal two-finger swipe produced dozens of
        // notches per second, which no amount of host-side tuning (System
        // Settings / LinearMouse) can tame. 1/100 with track-remainders (set
        // on zip_scroll_scaler upstream, so sub-notch motion is accumulated
        // rather than dropped) gives roughly one notch per 100 counts of
        // finger travel. Raise the divisor to slow scrolling further, lower it
        // to speed it up.
        //
        // zip_zoom_mapper is intentionally left out of this pipeline: the
        // pinch-to-zoom gesture it maps is disabled at the driver (see
        // toucan_right.overlay, `zoom;` removed), so it would never fire
        // anyway. Left in the tree (unreferenced) rather than deleted, in
        // case zoom is ever re-enabled.
        input-processors = <&pointer_rotate>, <&pointer_accel>, <&swipe_arbiter>, <&hscroll_shortcut>, <&zip_xy_scaler 100 100>, <&zip_scroll_scaler 1 100>, <&is_touching_processor>, <&swipe_button_mapper>;
        scroller {
            layers = <1 2>;
            input-processors = <
                &zip_xy_to_scroll_mapper
                &zip_scroll_scaler 1 100
                &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
            >;
        };
    };
};
