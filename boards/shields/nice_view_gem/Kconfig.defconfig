if SHIELD_NICE_VIEW_GEM

# Listing englmaxi's dongle_display shield after this one swaps in that status
# screen (bongo cat, modifiers, WPM). This shield then only provides the
# display node, so its LVGL sizing defaults give way to dongle_display's.

config TOUCAN_STATUS_SCREEN
    int "Status screen style (0 to 2)"
    default 2
    range 0 2

config LV_Z_VDB_SIZE
    default 100 if !SHIELD_DONGLE_DISPLAY

config LV_DPI_DEF
    default 161 if !SHIELD_DONGLE_DISPLAY

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM && !SHIELD_DONGLE_DISPLAY

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    imply NICE_VIEW_WIDGET_STATUS

config NICE_VIEW_WIDGET_STATUS
    default y if !SHIELD_DONGLE_DISPLAY
    select LV_USE_LABEL
    select LV_USE_IMG
    select LV_USE_CANVAS
    select LV_USE_ANIMIMG
    select LV_USE_ANIMATION
    # Central only: ZMK builds wpm.c for every role, but the keycode event it
    # subscribes to is only compiled for the central, so selecting WPM on a
    # split peripheral fails to link. Only the central screen shows WPM anyway.
    select ZMK_WPM if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config NICE_VIEW_WIDGET_INVERTED
    bool "Invert display colors"

if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL


endif # !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

endif # SHIELD_NICE_VIEW_GEM
